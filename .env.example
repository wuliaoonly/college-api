APP_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:5173
DATA_DIR=./data
ADMIN_USERNAME=admin
# Set a unique password before the first start. No built-in password.
ADMIN_PASSWORD=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty in development, a persistent data/encryption.key is generated.
ENCRYPTION_KEY=
PROVIDER_ALLOWED_HOSTS=api.deepseek.com

