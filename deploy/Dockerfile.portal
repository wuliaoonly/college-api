FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DATA_DIR=/app/data
WORKDIR /app
COPY portal/requirements.lock.txt /app/portal/requirements.lock.txt
RUN pip install --no-cache-dir --require-hashes -r portal/requirements.lock.txt && useradd --uid 10001 --create-home campus && mkdir -p /app/data /app/backups && chown campus:campus /app/data /app/backups
COPY portal /app/portal
COPY installer /app/installer
COPY ops /app/ops
USER campus
EXPOSE 8000
CMD ["uvicorn","portal.main:create_app","--factory","--host","0.0.0.0","--port","8000","--workers","1","--no-access-log","--proxy-headers","--forwarded-allow-ips","*"]
